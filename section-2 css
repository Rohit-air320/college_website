/* General Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
}

/* Navbar Styles */
.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    margin-bottom: 200px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #2c6399;
    /* Dark blue */
    padding: 40px 20px;
    color: white;
}

.logo {
    font-size: 1.5em;
    font-weight: bold;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 20px;
}

.nav-links li {
    display: inline;
}

.nav-links a {
    text-decoration: none;
    color: white;
    font-size: 1em;
    transition: color 0.3s;
}

.nav-links a:hover {
    color: #ffa500;
    /* Orange */
}

.load {
    background-color: gray;
    height: 40px;
    width: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
}

.load-text {
    white-space: nowrap;
    position: absolute;
    animation: move 10s linear infinite;
}

#clg_img {
    width: 100%;
    height: 600px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: red;
    overflow: hidden;
}

#clg_img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ensures the image fills the div while maintaining aspect ratio */
}

#department {
    width: auto;
    height: 600px;
    background-color: gray;
    display: flex;
    justify-content: center;
    /* align-items: center; */
}

#department_section {
    width: calc(100% - 200px);
    /* Max width minus 200px */
    height: 500px;
    background-color: rgb(223, 30, 30);
}

#department_section_heading {
    height: 10%;
    /* background-color: red; */
    display: flex;
    align-items: center;
    justify-content: center;
}

#department_section_heading p {
    font-size: 30px;
    font-weight: bold;
    font-family: Arial, sans-serif;
    color: #ffa500;
}

#department_section_branch {
    height: 30%;
    width: auto;
    background-color: red;
    display: flex;
}

#department_section_branch div {
    width: 25%;
    height: 100%;
    background-color: white;
}

@keyframes move {
    0% {
        transform: translateX(100%);
    }

    100% {
        transform: translateX(-100%);
    }
}

/* Responsive Design */
@media (max-width: 768px) {
    .nav-links {
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }

    #clg_img {
        height: 300px;
        /* Adjust height for smaller screens */
    }

    #department_section {
        width: calc(100% - 50px);
        /* Adjust width for smaller screens */
    }
}

/* footer style */

.fixed-footer {
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: #000;
    color: #fff;
    text-align: center;
    padding: 0px;
    z-index: 1000;
    margin-top: 20px;
}

#Primary_footer {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    padding: 60px;
}

.instu_info { 
    font-family: Arial, Helvetica, sans-serif;
    flex: 1;
    min-width: 250px;
    margin: 10px;
    text-align: left;
    color: gray;
}
.instu_info p{
    margin: 10px auto;
}

.campus_link{
    text-align: left;
    flex: 1; 
    min-width: 200px; 
    margin: 10px;
}


/* Add spacing between list items */
.custom-menu li {
    font-family: Arial, Helvetica, sans-serif;
    margin-bottom: 17px; /* Adds space below each list item */
}

.custom-menu {
    text-decoration: none;
    color: white;
    font-size: 1em;
    transition: color 0.3s;
    font-size: 17px;
    margin-top: 25px;
    list-style-type: none; /* Removes bullets */
    padding: 0; 
  }

  .custom-menu a{
    color: gray; 
    text-decoration: none
  }

  .custom-menu a:hover {
    color: #fff;
    /* white */
}

.green_showcase {

    margin-top: 10px;
    /* Spacing above the divider */
    height: 2px;
    /* Thickness of the divider */
    background-color: #00ff00;
    /* Green color */
    width: 100%;
    /* Width of the divider */
}

#secondary_footer {
    text-align: left;
    justify-content: space-between;
    margin-top: 20px;
    background-color: #2d2d2d;
    padding: 40px;
}
